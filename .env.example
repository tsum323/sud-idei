# Скопируйте в .env.local и заполните. Файл .env.local не попадает в Git.

# --- Claude API (обязательно) ---
# Ключ из Claude Console: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
# Модель и уровень effort (low | medium | high | xhigh | max)
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Тайм-аут одного вызова, мс, и число повторных попыток при временных ошибках
AI_TIMEOUT_MS=180000
AI_MAX_RETRIES=2
# Серверный fallback при отказе модели (on | off)
AI_FALLBACKS=on

# --- Веб-поиск (необязательно) ---
# none | tavily
SEARCH_PROVIDER=none
TAVILY_API_KEY=

# --- Хранилище ---
DATABASE_PATH=./data/ai-court.db
