# Скопируйте в .env.local и заполните. Файл .env.local не попадает в Git.

# --- AI-провайдер ---
# demo      — встроенный демонстрационный режим, без сети и без оплаты (по умолчанию)
# anthropic — реальные вызовы Claude API (нужен ключ API, оплата по токенам)
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
# Модель и уровень effort (low | medium | high | xhigh | max)
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Тайм-аут одного вызова, мс, и число повторных попыток при временных ошибках
AI_TIMEOUT_MS=180000
AI_MAX_RETRIES=2
# Серверный fallback при отказе модели (on | off)
AI_FALLBACKS=on

# --- Веб-поиск (необязательно) ---
# none | tavily
SEARCH_PROVIDER=none
TAVILY_API_KEY=

# --- Хранилище ---
DATABASE_PATH=./data/ai-court.db

# --- Только для демо-режима ---
# Задержка ответа агентов, мс (чтобы видеть состояние «Анализирует»)
DEMO_LATENCY_MS=900
# Идентификатор агента, который в демо-режиме всегда завершается ошибкой (для проверки)
DEMO_FAIL_AGENT=
