# Скопируйте в .env.local при необходимости. Без этого файла приложение работает
# через подписку Claude (Claude Code) с настройками по умолчанию.

# --- Модель ---
# claude-code   — через вашу подписку Claude Pro/Max (по умолчанию, без доплат)
# anthropic-api — через ключ Claude API (оплата по токенам)
AI_PROVIDER=claude-code
# Для claude-code — псевдоним (sonnet, opus) или полное имя модели; для API — например claude-opus-5-5
AI_MODEL=sonnet
# low | medium | high | xhigh | max
AI_EFFORT=medium
# Путь к программе claude, если она не в PATH
CLAUDE_BIN=
# Тайм-аут одного запроса, мс, и число повторов при временных ошибках
AI_TIMEOUT_MS=300000
AI_MAX_RETRIES=2

# --- Только для AI_PROVIDER=anthropic-api ---
ANTHROPIC_API_KEY=
AI_FALLBACKS=on

# --- Веб-поиск (необязательно) ---
# none | tavily
SEARCH_PROVIDER=none
TAVILY_API_KEY=

# --- Хранилище ---
DATABASE_PATH=./data/ai-court.db
